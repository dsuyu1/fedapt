    # Copy this file to `.env` and fill in your values.
# The notebooks auto-load `.env` (see the bootstrap cell). Real environment
# variables always take precedence over this file. `.env` is gitignored.

# NVD API key — register free at https://nvd.nist.gov/developers/request-an-api-key
# Raises the rate limit from ~5 to ~50 requests / 30s in 0_collection.
NVD_API_KEY=

# Where the corpus / adapters / results live.
#   Colab:  leave blank -> defaults to /content/drive/MyDrive/FedDAPT
#   Remote/local: point at your data dir, e.g. /data/fedapt
FEDDAPT_ROOT=

# Fast scratch dir for training temp files (defaults to the system temp dir).
FEDDAPT_WORK=

# Log client data (malicious): a checkout of splunk/attack_data (git-lfs, ~9GB).
FEDDAPT_ATTACK_DATA=

# Benign telemetry dir (negative class for the verdict task). Same log format.
# If blank and a teacher is set, negatives are synthesised instead.
FEDDAPT_BENIGN_DATA=

# Pluggable normalized log sources — the recommended way to supply BOTH classes
# from paper-backed public datasets (no Splunk lab needed). Comma-separated list
# of .jsonl files, or a directory of *.jsonl, produced by:
#     python scripts/convert_dataset.py --dataset ait|cic|cloudtrail --src ... --out ...
# Each record carries its own is_malicious flag. See docs/BENIGN_DATA.md.
FEDDAPT_LOG_SOURCES=

# Vendor threat-intel / IR write-ups (.json {title,content,vendor} or .txt) to add
# to the DAPT prose corpus. Respect each source's license/ToS. Blank = skip.
FEDDAPT_VENDOR_DATA=

# LLM judge (fedapt.judge). Use models DIFFERENT from the base under test.
# Two -> CLEV voting. Needs the provider key (e.g. ANTHROPIC_API_KEY).
# haiku-4-5 ($1/$5 per Mtok) + sonnet-4-6 ($3/$15) is the cheap pairing; both
# still accept temperature=0. The claude-3-5-* models were retired 2026-02-19.
FEDDAPT_JUDGE_MODELS=claude-haiku-4-5,claude-sonnet-4-6
ANTHROPIC_API_KEY=

# LOCAL models (no API key, no rate limits) via Ollama. Prefix any model with
# `ollama:` or `local:` for the --teacher flag or FEDDAPT_JUDGE_MODELS, e.g.
#   python scripts/build_data.py --teacher ollama:gemma2:9b
#   FEDDAPT_JUDGE_MODELS=ollama:gemma2:9b,ollama:qwen2.5:7b
# Start Ollama (`ollama serve`) and `ollama pull gemma2:9b` first. Host override:
FEDDAPT_OLLAMA_HOST=http://localhost:11434

